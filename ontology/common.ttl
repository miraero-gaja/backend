ma:OFFICIAL_SCHEMA a ma:EvidenceType .
ma:SIBLING_SCHEMA a ma:EvidenceType .
ma:PROFILE_ARTIFACT a ma:EvidenceType .
ma:INTERNAL_VALIDATION a ma:EvidenceType .

ma:Snapshot20260824 a ma:SourceSnapshot ;
    ma:snapshotDate "2026-08-24" ;
    ma:provenance "official 2026-08-24 source snapshot" .
